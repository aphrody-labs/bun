{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "@aphrody/bun-types"
    ],
    "paths": {
      "@aphrody/m3-react": [
        "../../packages/aphrody-migrated/m3/aphrody-m3/packages/m3-react/index.ts"
      ],
      "@aphrody/m3-react/video": [
        "../../packages/aphrody-migrated/m3/aphrody-m3/packages/m3-react/video/index.ts"
      ],
      "@aphrody/m3-react/adaptive": [
        "../../packages/aphrody-migrated/m3/aphrody-m3/packages/m3-react/adaptive/index.ts"
      ],
      "@aphrody/m3-react/transitions": [
        "../../packages/aphrody-migrated/m3/aphrody-m3/packages/m3-react/transitions/index.ts"
      ],
      "@aphrody/m3-react/state": [
        "../../packages/aphrody-migrated/m3/aphrody-m3/packages/m3-react/state/index.ts"
      ],
      "@aphrody/m3-react/adapters/tanstack": [
        "../../packages/aphrody-migrated/m3/aphrody-m3/packages/m3-react/adapters/tanstack.ts"
      ],
      "@aphrody/m3-react/wrappers/*": [
        "../../packages/aphrody-migrated/m3/aphrody-m3/packages/m3-react/wrappers/*"
      ],
      "@aphrody/m3-theme": [
        "../../packages/aphrody-migrated/m3/aphrody-m3/packages/m3-theme/src/index.ts"
      ],
      "@aphrody/m3-theme/react": [
        "../../packages/aphrody-migrated/m3/aphrody-m3/packages/m3-theme/src/react.tsx"
      ],
      "@aphrody/m3-react/video.css": [
        "../../packages/aphrody-migrated/m3/aphrody-m3/packages/m3-react/video/video.css"
      ]
    },
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "e2e/**/*",
    "desktop/**/*",
    "server.ts",
    "build.ts"
  ]
}
