# Release-only runtime image. Assets are downloaded and authenticated by the
# release workflow before Docker receives its context; no compilation here.
ARG BASE_IMAGE=ubuntu:26.04
FROM ${BASE_IMAGE}
ARG RUNTIME_ABI=gnu
RUN if [ "$RUNTIME_ABI" = musl ]; then \
      apk add --no-cache ca-certificates libstdc++ libgcc; \
    else \
      apt-get update && apt-get install -y --no-install-recommends ca-certificates \
      && rm -rf /var/lib/apt/lists/*; \
    fi
COPY bun /usr/local/bin/bun
COPY release-flavor.json /usr/local/share/bun/release-flavor.json
RUN chmod 0755 /usr/local/bin/bun && ln -s bun /usr/local/bin/bunx \
    && bun --version && bun -e 'if (6 * 7 !== 42) throw new Error("runtime smoke failed")'
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/bun"]
CMD ["--help"]
