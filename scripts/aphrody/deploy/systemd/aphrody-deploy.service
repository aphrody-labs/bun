# Une passe de la file de déploiement (build sur le VPS, transfert et activation sur dbfr). Voir docs/project/auto-deploy.mdx.
# Installation (VPS, utilisateur ubuntu) : bun scripts/aphrody/deploy/install-host.ts --role build
# (copie queue/lib/activate/clean dans ~/.local/lib/aphrody-deploy, le lanceur ~/.local/bin/aphrody-deploy et ces unités
# dans ~/.config/systemd/user/, puis systemctl --user enable --now aphrody-deploy.timer).
[Unit]
Description=File de déploiement automatique (aphrody-deploy)
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/aphrody-deploy --once
Nice=19
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
MemoryHigh=6G
MemoryMax=10G
TimeoutStartSec=2h
SuccessExitStatus=75
