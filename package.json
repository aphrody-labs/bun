{
  "name": "bun",
  "version": "1.4.7",
  "private": true,
  "repository": "github:aphrody-labs/bun",
  "workspaces": [
    "./packages/bun-runtime-sdk",
    "./packages/bun-google",
    "./packages/bun-types",
    "./packages/bun-sql",
    "./packages/bun-x",
    "./packages/bun-fuzzy",
    "./packages/bun-qr",
    "./packages/bun-timeline"
  ],
  "scripts": {
    "gn": "bun scripts/aphrody/gn.ts",
    "gn:vendor": "bun scripts/aphrody/vendor-gn.ts",
    "vendor:audit": "bun scripts/aphrody/vendor-audit.ts",
    "vendor:setup": "bun scripts/aphrody/vendor-setup.ts",
    "depots_tools": "bun scripts/aphrody/chromium.ts --depot-tools",
    "depot_tools": "bun scripts/aphrody/chromium.ts --depot-tools",
    "chromium": "bun scripts/aphrody/chromium.ts",
    "factory": "bun scripts/factory/factory.ts",
    "cef": "bun scripts/aphrody/cef.ts",
    "chrome": "bun scripts/aphrody/browser.ts chrome",
    "obscura": "bun scripts/aphrody/browser.ts obscura",
    "bun:windows": "bun scripts/aphrody/win/version-sync.ts",
    "build": "bun --silent run build:debug",
    "ci:find": "bun scripts/find-build.ts",
    "ci:status": "bun scripts/find-build.ts --status",
    "ci:errors": "bun scripts/find-build.ts --errors",
    "ci:logs": "bun scripts/find-build.ts --logs",
    "ci:watch": "bun scripts/find-build.ts --watch",
    "ci:images": "bun scripts/build/ci-images/spec.ts",
    "ci:slowest": "bun scripts/ci-slowest-tests.ts",
    "ci:parallel-allowlist": "bun scripts/update-parallel-allowlist.mjs",
    "pr:comments": "bun scripts/pr-comments.ts",
    "watch": "cargo watch -x 'check --message-format=short'",
    "watch-windows": "cargo watch -x \"check --target x86_64-pc-windows-msvc --message-format=short\"",
    "bd:v": "bun scripts/build.ts --profile=debug",
    "bd": "BUN_DEBUG_QUIET_LOGS=1 bun scripts/build.ts --profile=debug --quiet",
    "agent-plugin": "bun scripts/aphrody/agent-plugin.ts",
    "release:surfaces": "bun scripts/aphrody/release-surfaces.ts",
    "delivery": "bun scripts/aphrody/monorepo-delivery.ts",
    "verify:fusion": "bun scripts/aphrody/verify-fusion.ts",
    "delivery:native": "bun scripts/aphrody/delivery-native.ts",
    "build:debug": "bun scripts/build.ts --profile=debug",
    "build:debug:fuzzilli": "bun scripts/build.ts --profile=debug --fuzzilli=on --build-dir=build/debug-fuzz",
    "build:debug:noasan": "bun scripts/build.ts --profile=debug-no-asan",
    "build:release": "bun scripts/build.ts --profile=release",
    "build:ci": "bun scripts/build.ts --profile=release --ci=on --buildkite=on --build-dir=build/release-ci",
    "build:assert": "bun scripts/build.ts --profile=release-assertions --build-dir=build/release-assert",
    "build:asan": "bun scripts/build.ts --profile=release-asan --build-dir=build/release-asan",
    "build:logs": "bun scripts/build.ts --profile=release --logs=on --build-dir=build/release-logs",
    "build:smol": "bun scripts/build.ts --profile=release --build-type=MinSizeRel --build-dir=build/release-smol",
    "build:local": "bun scripts/build.ts --profile=debug-local --build-dir=build/debug-local",
    "build:types": "bun scripts/build.ts --mode=codegen --target=generated-types",
    "build:release:local": "bun scripts/build.ts --profile=release-local --build-dir=build/release-local",
    "run:linux": "docker run --rm  -v \"$PWD:/root/bun/\" -w /root/bun ghcr.io/oven-sh/bun-development-docker-image",
    "uv-posix-stubs": "bun run src/jsc/bindings/libuv/generate_uv_posix_stubs.ts",
    "orderfile": "bun scripts/orderfile/generate.ts",
    "jsc:build": "bun scripts/build.ts --profile=release-local --build-dir=build/release-local --target=jsc",
    "jsc:build:debug": "bun scripts/build.ts --profile=debug-local --build-dir=build/debug-local --target=jsc",
    "jsc:build:lto": "bun scripts/build.ts --profile=release-local --lto=on --build-dir=build/release-local-lto --target=jsc",
    "typecheck": "bun check --noEmit && bun check --noEmit --project test/tsconfig.json",
    "fmt": "bun fmt",
    "fmt:cpp": "bun run clang-format",
    "fmt:rust": "cargo fmt --all",
    "lint": "bun lint",
    "lint:fix": "bun lint --config oxlint.json --fix src/js",
    "test": "bun scripts/runner.node.ts --exec-path ./build/debug/bun-debug",
    "testleak": "BUN_DESTRUCT_VM_ON_EXIT=1 ASAN_OPTIONS=detect_leaks=1 LSAN_OPTIONS=malloc_context_size=100:print_suppressions=1:suppressions=$npm_config_local_prefix/test/leaksan.supp ./build/debug/bun-debug",
    "test:release": "bun scripts/runner.node.ts --exec-path ./build/release/bun",
    "rust:check": "cargo check --keep-going",
    "rust:check-all": "bun scripts/rust-check-all.ts",
    "rust:check-wasm": "cargo check --target wasm32-wasip1-threads -p bun_wasm --profile wasm",
    "rust:clippy": "cargo clippy --no-deps --keep-going",
    "rust:mordant": "bun scripts/rust-mordant.ts",
    "rust:mordant:baseline": "bun scripts/rust-mordant.ts --baseline",
    "rust:miri": "bun scripts/rust-miri.ts",
    "rust:nextest": "bun scripts/rust-nextest.ts",
    "rust:deny": "cargo deny --workspace check",
    "codegen:string-maps": "for f in src/**/*.string-map.ts; do bun src/codegen/generate-string-map.ts \"$f\" \"${f%.string-map.ts}.generated.rs\"; done",
    "codegen:agent-tools": "bun src/codegen/generate-agent-tools.ts",
    "codegen:verify": "bun src/codegen/generate-agent-tools.ts --check && (bun run codegen:string-maps && git diff --exit-code 'src/**/*.generated.rs' || (echo '\\n*.generated.rs is stale — run `bun run codegen:string-maps` and commit the result.' >&2; exit 1))",
    "clang-format": "./scripts/run-clang-format.sh format",
    "clang-format:check": "./scripts/run-clang-format.sh check",
    "clang-format:diff": "./scripts/run-clang-format.sh diff",
    "node:test": "bun ./scripts/runner.node.ts --quiet --exec-path=$npm_execpath --node-tests ",
    "node:test:cp": "bun ./scripts/fetch-node-test.ts ",
    "clean": "bun scripts/build/clean.ts",
    "sync-webkit-source": "bun ./scripts/sync-webkit-source.ts",
    "pyjs": "bun scripts/aphrody/pyjs.ts",
    "buv:check": "bun scripts/aphrody/buv.ts check",
    "buv:test": "bun scripts/aphrody/buv.ts test",
    "buv:lint": "bun scripts/aphrody/buv.ts lint",
    "buv:fmt": "bun scripts/aphrody/buv.ts fmt",
    "buv:metadata": "bun scripts/aphrody/buv.ts metadata",
    "buv:docs": "bun scripts/aphrody/buv.ts docs",
    "buv:embedded": "bun scripts/aphrody/buv.ts embedded",
    "buv:bench": "bun scripts/aphrody/bench.ts",
    "buv:formats": "bun scripts/aphrody/formats.ts",
    "libmpv": "bun scripts/aphrody/libmpv.ts",
    "ffmpeg": "bun scripts/aphrody/ffmpeg.ts",
    "libplacebo": "bun scripts/aphrody/libplacebo.ts",
    "media:stage": "bun scripts/aphrody/media-stage.ts"
  },
  "devDependencies": {
    "@aphrody/bun-runtime-sdk": "workspace:*",
    "@lezer/common": "1.5.3",
    "@lezer/cpp": "1.1.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.21.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "source-map-js": "1.2.1",
    "typescript": "6.0.2",
    "undici-types": "8.3.0"
  },
  "resolutions": {
    "@types/node": "26.2.0",
    "bun-types": "workspace:packages/bun-types"
  }
}
