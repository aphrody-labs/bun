{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The code generators import from scripts/build, which `composite` would have listed here file by file.
    "composite": false,
    // bun-types comes in through `include` below, by path: see src/js/tsconfig.json.
    "types": [],
    "paths": {
      // What codegen/builtins/load-declaration-files.ts registers under this name.
      "bun-builtins-table": ["./codegen/builtins/lib.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../packages/bun-types/index.d.ts"],
  // js and runtime/bake are projects of their own, with settings that only apply there. The `bun init` and
  // `bun create` templates are users' projects: each has its own tsconfig and dependencies that are not installed
  // here (`cli` is a link to `runtime/cli`). The libuv stub generator needs tree-sitter, which is not installed.
  "exclude": [
    "js",
    "runtime/bake",
    "runtime/cli/init",
    "runtime/cli/create",
    "cli/init",
    "cli/create",
    "jsc/bindings/libuv",
    // JavaScript development tools have their own projects; their Rust owners remain in Cargo.
    "quality/lint_cli",
    "quality/format_cli",
    "quality/shared",
    // Package-owned benches, browser conformance tools and intentional Node migration inputs.
    "migrate/tests/fixtures",
    "quality/adapters/parser/test-browser",
    "quality/adapters/parser/vitest.config*.ts",
    "codegen/ecma_js/bench.bench.ts",
    "codegen/ecma_js/tsdown.config.ts",
    "codegen/ecma_js/tsdown_plugins",
    "codegen/ecma_transform_conformance/update_fixtures.ts",
    "codegen/ecma_coverage/misc",
    "codegen/ecma_coverage/snapshots",
    "codegen/ecma_js/test",
    "codegen/ecma_rulegen/src/snapshots",
    "codegen/ecma_transform_conformance/overrides/babel-plugin-transform-class-properties/test",
    "codegen/ecma_transform_conformance/overrides/babel-plugin-transform-logical-assignment-operators/test",
    "codegen/ecma_transform_conformance/overrides/babel-plugin-transform-object-rest-spread/test",
    "codegen/ecma_transform_conformance/overrides/babel-plugin-transform-optional-chaining/test",
    "codegen/ecma_transform_conformance/overrides/babel-plugin-transform-private-methods/test",
    "codegen/ecma_transform_conformance/overrides/babel-plugin-transform-private-property-in-object/test",
    "codegen/ecma_transform_conformance/overrides/babel-plugin-transform-react-jsx/test",
    "codegen/ecma_transform_conformance/overrides/babel-plugin-transform-typescript/test",
    "codegen/ecma_transform_conformance/snapshots",
    "codegen/ecma_transform_conformance/tests",
    "codegen/ecma_website_formatter/src/snapshots",
    "codegen/ecma_website_linter/src/rules/snapshots",
    "codegen/ecma_website_linter/src/snapshots",
    "collections/arena/tests",
    "js_parser/lexer/tests",
    "js_parser/regexp/tests",
    "js_printer/ecma/tests",
    "lsp/quality/fixtures",
    "parsers/json_schema/tests",
    "quality/adapters/minify/test",
    "quality/adapters/parser/test",
    "quality/adapters/react/test",
    "quality/adapters/relay/test",
    "quality/adapters/transform/test",
    "quality/format_cli/conformance/fixtures",
    "quality/format_cli/conformance/snapshots",
    "quality/format_cli/test",
    "quality/format_css/tests",
    "quality/format_graphql/tests",
    "quality/format_js/tests",
    "quality/format_json/tests",
    "quality/format_markdown/tests",
    "quality/format_yaml/tests",
    "quality/lint_cli/conformance/snapshots",
    "quality/lint_cli/fixtures",
    "quality/lint_cli/src/lsp/snapshots",
    "quality/lint_cli/src/snapshots",
    "quality/lint_cli/test",
    "quality/linter/fixtures",
    "quality/linter/src/config/snapshots",
    "quality/linter/src/rules/eslint/no_unused_vars/tests",
    "quality/linter/src/snapshots",
    "quality/linter/tests",
    "quality/shared/test",
    "react_compiler/ecma/fixtures",
    "react_compiler/ecma/tests",
    "resolver/ecma/fixtures",
    "sema/cfg/tests",
    "sema/ecma/tests",
    "transpiler/declarations/tests",
    "transpiler/ecma/tests",
    "transpiler/minifier/tests",
    "transpiler/plugins/tests",
    "transpiler/relay/tests"
  ]
}
