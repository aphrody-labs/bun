{
  "$schema": "../../../packages/bun-oxc/adapters/format/configuration_schema.json",
  "experimentalOperatorPosition": "start",
  "ignorePatterns": [
    "**/tests/**",
    // Ignore `fixtures` directories except for `src/quality/lint_cli/test/fixtures`
    "**/fixtures/**",
    "!apps/oxlint/test/fixtures/**",
    "src/quality/lint_cli/test/fixtures/bom/files/**",
    "src/quality/lint_cli/test/fixtures/fixes/files/**",
    "src/quality/lint_cli/test/fixtures/plugin_eslint/files/**",
    "src/quality/lint_cli/test/fixtures/suggestions/files/**",
    "src/quality/lint_cli/test/fixtures/sourceCode_token_methods/files/**",
    "src/quality/lint_cli/test/fixtures/tokens/files/**",
    "src/quality/lint_cli/test/fixtures/tokens_unambiguous_await/files/**",
    "**/dist/**",
    "**/generated/**",
    "**/CHANGELOG.md",
    "**/*.snap.md",
    "**/DIVERGENCES.md",
    "src/quality/format_cli/conformance/snapshots/**",
    "src/quality/lint_cli/conformance/snapshots/**",
    "src/codegen/ecma_coverage/node-compat-table",
    "src/codegen/ecma_coverage/misc",
    "src/codegen/ecma_coverage/src/runtime/babelHelpers.js",
    "src/codegen/ecma_transform_conformance/tests",
    "apps/{oxlint,oxfmt}/src-js/bindings.js",
    "apps/{oxlint,oxfmt}/src-js/bindings.d.ts",
    "src/quality/lint_cli/src-js/generated/",
    "src/quality/lint_cli/src-js/package/config.generated.ts",
    "src/quality/format_cli/src-js/config.generated.ts",
    "src/quality/lint_cli/conformance/submodules/**",
    "packages/bun-oxc/src/parser-core/bindings.js",
    "src/codegen/ecma_codegen_conformance/index.js",
    "src/codegen/ecma_codegen_conformance/index.d.ts",
    "src/quality/adapters/playground/playground.wasi-browser.js",
    "napi/{transform,transform-react,transform-relay,minify,playground}/index.js",
    "napi/{transform,transform-react,transform-relay,minify,playground}/index.d.ts",
    "napi/{parser,transform,transform-react,transform-relay,minify,playground}/**/index.d.ts",
    "napi/{parser,transform,transform-react,transform-relay,minify,playground}/**/*.wasi.d.cts",
    "napi/{parser,transform,transform-react,transform-relay,minify,playground}/**/*.wasi-browser.js",
    "napi/{parser,transform,transform-react,transform-relay,minify,playground}/**/*.wasi.cjs",
    "napi/{parser,transform,transform-react,transform-relay,minify}/**/*.wasip1*",
    "napi/{parser,transform,transform-react,transform-relay,minify,playground}/**/wasi-worker-browser.mjs",
    "napi/{parser,transform,transform-react,transform-relay,minify,playground}/**/wasi-worker.mjs",
    "napi/{parser,transform,transform-react,transform-relay,minify,playground}/**/browser.js",
    "packages/bun-oxc/adapters/runtime_npm/src",
    "packages/bun-oxc/adapters/types_npm/types.d.ts",
    "packages/bun-oxc/adapters/format/configuration_schema.json",
    "packages/bun-oxc/adapters/lint/configuration_schema.json",
  ],
}
