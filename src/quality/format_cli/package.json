  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@napi-rs/cli": "3.10.6",
    "@oxapps/shared": "file:../shared",
    "@types/node": "24.1.0",
    "diff": "^9.0.0",
    "execa": "^10.0.0",
    "json-schema-to-typescript": "16.0.0",
    "svelte": "^5.56.2",
    "tsdown": "0.23.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
