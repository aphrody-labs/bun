{
  "name": "oxc-parser",
  "version": "0.153.0",
  "description": "Oxc Parser Node API",
  "keywords": [
    "ast",
    "estree",
    "javascript",
    "oxc",
    "parser",
    "typescript"
  ],
  "homepage": "https://oxc.rs/docs/guide/usage/parser",
  "bugs": "https://github.com/oxc-project/oxc/issues",
  "license": "MIT",
  "author": "Boshen and oxc contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxc-project/oxc.git",
    "directory": "src/quality/adapters/parser"
  },
  "funding": {
    "url": "https://github.com/sponsors/oxc-project"
  },
  "type": "module",
  "main": "../../../../packages/bun-oxc/src/parser-core/index.js",
  "browser": "../../../../packages/bun-oxc/src/parser-core/wasm.js",
  "scripts": {
    "build-dev": "bun ../../../../scripts/aphrody/build-napi.ts packages/bun-oxc --debug",
    "build-test": "bun run build-dev",
    "build": "bun ../../../../scripts/aphrody/build-napi.ts packages/bun-oxc",
    "build-wasi": "napi build --js bindings.js --config-path napi.wasm.json --target wasm32-wasip1-threads --dts parser.wasi.d.cts --no-dts-header --output-dir ../../../../build/quality/parser",
    "build-wasm": "bun run build-wasm-dev --release",
    "build-wasm-dev": "napi build --js bindings.js --esm --platform --target wasm32-wasip1-threads --dts parser.wasi.d.cts --no-dts-header --output-dir ../../../../build/quality/parser",
    "build-wasip1": "bun run build-wasip1-dev --release",
    "build-wasip1-dev": "napi build --js bindings.js --esm --platform --target wasm32-wasip1 --dts parser.wasip1.d.cts --no-dts-header --output-dir ../../../../build/quality/parser",
    "build-npm-dir": "rm -rf npm-dir && napi create-npm-dirs --config-path napi.wasm.json --npm-dir npm-dir && bunx napi artifacts --config-path napi.wasm.json --npm-dir npm-dir --output-dir ../../../../build/quality/parser",
    "build-browser-bundle": "bun scripts/build-browser-bundle.js",
    "test": "bun run test-node run",
    "test-node": "vitest --dir ./test",
    "test-browser": "vitest -c vitest.config.browser.ts",
    "bench": "vitest bench --run ./bench.bench.js",
    "postbuild-wasm-dev": "bun scripts/patch.js --out-dir ../../../../build/quality/parser",
    "postbuild-wasip1-dev": "bun scripts/patch.js --out-dir ../../../../build/quality/parser"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.0.0",
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@napi-rs/cli": "3.10.6",
    "@napi-rs/wasm-runtime": "1.2.4",
    "@types/node": "24.1.0",
    "@typescript-eslint/visitor-keys": "^8.54.0",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "playwright": "^1.51.0",
    "publint": "0.3.24",
    "rolldown": "1.2.12",
    "tinypool": "^2.0.0",
    "vitest": "5.0.1"
  },
  "napi": {
    "binaryName": "parser",
    "dtsHeaderFile": "../../../../packages/bun-oxc/src/parser-core/header.d.ts",
    "packageName": "@oxc-parser/binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-linux-android",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-unknown-linux-ohos",
      "armv7-linux-androideabi",
      "armv7-unknown-linux-gnueabihf",
      "armv7-unknown-linux-musleabihf",
      "i686-pc-windows-msvc",
      "powerpc64le-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "riscv64gc-unknown-linux-musl",
      "s390x-unknown-linux-gnu",
      "wasm32-wasip1",
      "wasm32-wasip1-threads",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-freebsd",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ],
    "wasm": {
      "browser": {
        "fs": false
      }
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true,
  "types": "../../../../packages/bun-oxc/src/parser-core/index.d.ts"
}
