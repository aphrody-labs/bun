{
  "name": "@omar/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": [
    "server",
    "server/apps/bun-webos",
    "server/apps/bun-plugin-tailwind"
  ],
  "scripts": {
    "status": "bun --no-env-file server/probe-server.ts",
    "features": "bun --no-env-file server/configure-runtime-features.ts",
    "index:system32": "bun --no-env-file server/index-system32.ts",
    "index:ntfs": "bun --no-env-file server/ntfs-index.ts",
    "index:sync": "bun --no-env-file server/ntfs-index-sync.ts",
    "index:aliases": "bun --no-env-file server/ntfs-index-pe-paths.ts",
    "index:graph": "bun --no-env-file server/source-graph-index.ts",
    "cache:warm": "bun --no-env-file server/warmCache.ts",
    "webos:build": "bun --no-env-file --cwd server/apps/bun-webos build.ts",
    "webos:manifest": "bun --no-env-file server/manifest-webos.ts",
    "graph": "bun --no-env-file server/graph.ts",
    "index:graph:bun": "bun --no-env-file server/source-graph-index.ts --source bun-os",
    "index:graph:aphrody": "bun --no-env-file server/source-graph-index.ts --source aphrody"
  },
  "systemDependencies": {
    "winget:NASM.NASM": "3.02",
    "winget:RubyInstallerTeam.RubyWithDevKit.3.3": "3.3.12-1"
  }
}
