{
  "name": "@aphrody/bun-webos",
  "version": "1.4.4",
  "private": true,
  "description": "WebOS served by Bun: every app calls a native Bun API (Bun.serve, Bun Shell, Bun.Terminal, bun:sqlite, bun:ffi, Bun.Archive, Bun.Glob, Bun.markdown, workers)",
  "license": "Apache-2.0",
  "type": "module",
  "module": "server.ts",
  "exports": {
    ".": "./server.ts"
  },
  "bin": {
    "bun-webos": "./server.ts"
  },
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "build": "bun build.ts",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@aphrody/m3-tokens": "^3.3.7",
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@fluentui/web-components": "^3.1.3",
    "@microsoft/fast-element": "^3",
    "@microsoft/focusgroup-polyfill": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@aphrody/bun-plugin-tailwind": "workspace:*"
  }
}
