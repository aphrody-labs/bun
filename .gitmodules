[submodule "@aphrody/m3"]
	path = packages/aphrody-migrated/m3/aphrody-m3
	url = https://github.com/aphrody-labs/aphrody-m3.git
[submodule "vendor/brave-core"]
	path = vendor/brave-core
	url = https://github.com/aphrody-labs/brave-core.git
	shallow = true
[submodule "vendor/filmcraft"]
	path = vendor/filmcraft
	url = https://github.com/aphrody-labs/filmcraft.git
[submodule "vendor/photocraft"]
	path = vendor/photocraft
	url = https://github.com/aphrody-labs/photocraft.git
