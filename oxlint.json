{
  "$schema": "./packages/bun-oxc/adapters/lint/configuration_schema.json",
  "jsPlugins": ["./scripts/oxlint-plugins/bun.js"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "const-comparisons": "error",
    "no-cond-assign": "error",
    "no-const-assign": "error",
    "no-debugger": "error",
    "no-dupe-class-members": "error",
    "no-dupe-keys": "error",
    "no-empty-pattern": "error",
    "import/no-duplicates": "error",

    "no-control-regex": "off",

    "no-useless-escape": "off",
    "no-this-alias": "off", // many intentional this aliases
    "triple-slash-reference": "off", // many intentional triple slash references

    // This rule is dumb.
    // Array.from is MUCH slower than new Array(size).
    "no-new-array": "off",

    // We have custom thenables. This is not a bug.
    "no-thenable": "off",

    // We use this in some cases. The ordering is deliberate.
    "no-unsafe-finally": "off",

    // We use !!$debug to check if the debugger is enabled.
    // Boolean() is also generally slower than !!.
    "no-extra-boolean-cast": "off",

    // Eslint is not a type checker.
    "no-throw-literal": "off"
  },
  "ignorePatterns": [
    "**/fixtures/",
    "**/baselines/",
    // Byte-exact ECMA conformance inputs and snapshots transferred into source owners.
    "src/codegen/ecma_coverage/misc/",
    "src/codegen/ecma_coverage/snapshots/",
    "src/codegen/ecma_js/test/",
    "src/codegen/ecma_rulegen/src/snapshots/",
    "src/codegen/ecma_transform_conformance/overrides/babel-plugin-transform-class-properties/test/",
    "src/codegen/ecma_transform_conformance/overrides/babel-plugin-transform-logical-assignment-operators/test/",
    "src/codegen/ecma_transform_conformance/overrides/babel-plugin-transform-object-rest-spread/test/",
    "src/codegen/ecma_transform_conformance/overrides/babel-plugin-transform-optional-chaining/test/",
    "src/codegen/ecma_transform_conformance/overrides/babel-plugin-transform-private-methods/test/",
    "src/codegen/ecma_transform_conformance/overrides/babel-plugin-transform-private-property-in-object/test/",
    "src/codegen/ecma_transform_conformance/overrides/babel-plugin-transform-react-jsx/test/",
    "src/codegen/ecma_transform_conformance/overrides/babel-plugin-transform-typescript/test/",
    "src/codegen/ecma_transform_conformance/snapshots/",
    "src/codegen/ecma_transform_conformance/tests/",
    "src/codegen/ecma_website_formatter/src/snapshots/",
    "src/codegen/ecma_website_linter/src/rules/snapshots/",
    "src/codegen/ecma_website_linter/src/snapshots/",
    "src/collections/arena/tests/",
    "src/js_parser/lexer/tests/",
    "src/js_parser/regexp/tests/",
    "src/js_printer/ecma/tests/",
    "src/lsp/quality/fixtures/",
    "src/parsers/json_schema/tests/",
    "src/quality/adapters/minify/test/",
    "src/quality/adapters/parser/test/",
    "src/quality/adapters/react/test/",
    "src/quality/adapters/relay/test/",
    "src/quality/adapters/transform/test/",
    "src/quality/format_cli/conformance/fixtures/",
    "src/quality/format_cli/conformance/snapshots/",
    "src/quality/format_cli/test/",
    "src/quality/format_css/tests/",
    "src/quality/format_graphql/tests/",
    "src/quality/format_js/tests/",
    "src/quality/format_json/tests/",
    "src/quality/format_markdown/tests/",
    "src/quality/format_yaml/tests/",
    "src/quality/lint_cli/conformance/snapshots/",
    "src/quality/lint_cli/fixtures/",
    "src/quality/lint_cli/src/lsp/snapshots/",
    "src/quality/lint_cli/src/snapshots/",
    "src/quality/lint_cli/test/",
    "src/quality/linter/fixtures/",
    "src/quality/linter/src/config/snapshots/",
    "src/quality/linter/src/rules/eslint/no_unused_vars/tests/",
    "src/quality/linter/src/snapshots/",
    "src/quality/linter/tests/",
    "src/quality/shared/test/",
    "src/react_compiler/ecma/fixtures/",
    "src/react_compiler/ecma/tests/",
    "src/resolver/ecma/fixtures/",
    "src/sema/cfg/tests/",
    "src/sema/ecma/tests/",
    "src/transpiler/declarations/tests/",
    "src/transpiler/ecma/tests/",
    "src/transpiler/minifier/tests/",
    "src/transpiler/plugins/tests/",
    "src/transpiler/relay/tests/",
    "test/integration/ecma_pipeline/",
    "src/codegen/ecma_minsize/minsize.snap",
    "src/codegen/ecma_track_linter_timings/linter_timings.snap",
    // These are compiler outputs, upstream conformance inputs, and intentionally
    // malformed parser/runtime fixtures, rather than maintained helper source.
    "test/snapshots/**",
    "test/**/fixture/**",
    "test/**/*fixture*/**",
    "test/**/*fixture*",
    // Bun-only loader syntax and generated bytecode input exceed this parser.
    "test/js/bun/console/console-iterator-run.ts",
    "test/bundler/bytecode-portability/builtin.js",
    "test/**/fixtures/**",
    "test/bundler/transpiler/react-compiler-fixtures/**",
    "test/js/third_party/**",
    "test/napi/node-napi-tests/**",
    "test/js/node/test/**",
    // TS7.1 ambient import attributes and a Handlebars template are not parseable
    // by the pinned JavaScript linter; their declaration/template owners validate them.
    "packages/bun-types/ts7.1/import-attributes.d.ts",
    "vendor",
    // Third-party bundles, minified libraries and vendored runtimes shipped verbatim as assets.
    "packages/bun-video/hyperframes/registry/**/*.min.js",
    "packages/bun-video/hyperframes/registry/**/*.iife.js",
    "packages/bun-video/hyperframes/registry/blocks/*/assets/**",
    "packages/bun-video/hyperframes/registry/blocks/*/source/src/vendor/**",
    "packages/bun-video/hyperframes/skills/**/*.min.js",
    "packages/bun-video/hyperframes/skills/**/vendor/**",
    "packages/bun-video/hyperframes/producer/tests/**/vendor/**",
    "packages/bun-video/hyperframes/cli/src/media-use/lib/svg-sanitize.mjs",
    "packages/bun-oxc/adapters/runtime_npm/**",
    "packages/bun-oxc/src/parser-core/**",
    "build",
    "**/.pytest_cache/**",
    "bench",
    "bench/react-hello-world/*.js",
    "bun.lock",

    // Verbatim ports from Node.js v26.3.0 (lib/) — keep close to upstream
    "src/js/node/repl.ts",
    "src/js/node/readline.ts",
    "src/js/node/readline.promises.ts",
    "src/js/internal/repl.ts",
    "src/js/internal/readline/**",
    "src/js/internal/repl/history.ts",
    "src/js/internal/repl/utils.ts",
    "src/js/internal/repl/completion.ts",
    "src/js/internal/repl/await.ts",
    "src/js/internal/repl/acorn.ts",
    "src/js/internal/repl/acorn-walk.ts",

    "test/js/node/**/parallel/**",
    "test/js/node/test/fixtures", // full of JS with intentional syntax errors
    "test/snippets/**",
    "test/regression/issue/14477/*.tsx",
    "test/js/**/*bad.js",
    "test/bundler/transpiler/decorators.test.ts", // uses `arguments` as decorator
    "test/bundler/native-plugin.test.ts", // parser doesn't handle import metadata
    "test/bundler/transpiler/with-statement-works.js", // parser doesn't allow `with` statement
    "test/js/node/module/extensions-fixture", // these files are not meant to be linted
    "test/cli/run/module-type-fixture",

    // TODO: fix these
    "src/js/node/http2.ts",
    "src/js/node/http.ts"
  ],

  "overrides": [
    {
      // Runtime tests deliberately evaluate getters, unreachable branches and
      // sparse arrays to assert their behavior; helper source keeps these rules.
      "files": ["test/**/*.test.*", "test/**/*.spec.*"],
      "rules": {
        "no-unused-expressions": "off",
        "no-unreachable": "off",
        "no-sparse-arrays": "off"
      }
    },
    {
      // Fetch suites exercise rejected options and Bun GET-body compatibility.
      "files": ["test/js/web/fetch/**", "test/js/bun/http/*.test.ts"],
      "rules": { "unicorn/no-invalid-fetch-options": "off" }
    },
    // Exact declaration, injected-payload, generated-bundle and upstream-fixture
    // exceptions; runtime source correctness rules remain enabled elsewhere.
    {
      "files": [
        "packages/bun-debug-adapter-protocol/src/debugger/fixtures/without-sourcemap.js",
        "packages/bun-dotnet/dotnet/test/TestCases/edgejs-perf/measure-latency.js",
        "packages/bun-dotnet/dotnet/test/TestCases/napi-dotnet/dynamic_optional_params.js",
        "packages/bun-dotnet/dotnet/test/TestCases/napi-dotnet/streams.js",
        "packages/bun-dotnet/dotnet/test/TestCases/node-addon-api/basic_types/value.js",
        "packages/bun-dotnet/dotnet/test/TestCases/node-addon-api/object/object.js",
        "packages/bun-n2b/crates/n2b/tests/fixtures/node-project/src/server.ts",
      ],
      "rules": {
        "eslint/no-unused-vars": "off"
      }
    },
    {
      // Obscura's DOM emulation keeps WebIDL parameter names (Function.length is
      // page-observable) and implements page evaluation with eval.
      "files": ["src/browser/crates/js/js/bootstrap.js"],
      "rules": {
        "eslint/no-unused-vars": ["error", { "args": "none", "caughtErrors": "none", "varsIgnorePattern": "^_" }],
        "eslint/no-eval": "off"
      }
    },
    {
      "files": ["packages/bun-supervisor/src/budget.ts"],
      "rules": {
        "unicorn/no-useless-spread": "off"
      }
    },
    {
      "files": [
        "packages/bun-dotnet/dotnet/docs/tools/build-dotnet-api-docs.js",
        "packages/bun-dotnet/dotnet/test/TestCases/common/index.js",
        "packages/bun-dotnet/dotnet/test/TestCases/napi-dotnet/multi_instance.js"
      ],
      "rules": {
        "unicorn/prefer-string-starts-ends-with": "off"
      }
    },
    {
      "files": [
        "packages/bun-webview-core/src/input.js"
      ],
      "rules": {
        "eslint/no-unused-expressions": "off"
      }
    },
    {
      "files": [
      ],
      "rules": {
        "eslint/constructor-super": "off"
      }
    },
    {
      "files": [
        "packages/bun-types/globals.d.ts"
      ],
      "rules": {
        "eslint/no-shadow-restricted-names": "off"
      }
    },
    {
      "files": ["packages/bun-types/bun.d.ts"],
      "rules": {
        "typescript/no-misused-new": "off"
      }
    },
    {
      "files": ["packages/bun-types/test.d.ts"],
      "rules": {
        "typescript/no-wrapper-object-types": "off"
      }
    },
    {
      "files": ["packages/bun-vscode/src/features/tests/__tests__/vscode-types.mock.ts"],
      "rules": {
        "typescript/no-unsafe-declaration-merging": "off"
      }
    },
    {
      "files": ["packages/bun-types/ffi.d.ts"],
      "rules": {
        "typescript/no-duplicate-enum-values": "off"
      }
    },
    {
      "files": ["packages/bun-types/jsx.d.ts"],
      "rules": {
        "typescript/no-useless-empty-export": "off"
      }
    },
    {
      // Orderfile workloads deliberately exercise errors and less efficient idioms
      // to collect native profiles. Rewriting them changes the measured workload.
      "files": ["scripts/orderfile/app/**"],
      "rules": {
        "no-caller": "off",
        "no-sparse-arrays": "off",
        "no-constant-binary-expression": "off",
        "no-unused-expressions": "off",
        "no-unused-labels": "off",
        "no-unused-vars": "off",
        "unicorn/no-unnecessary-await": "off",
        "unicorn/no-useless-spread": "off",
        "unicorn/prefer-set-size": "off",
        "oxc/number-arg-out-of-range": "off"
      }
    },
    {
      "files": ["test/**"],
      "rules": {
        "no-unused-vars": "off",
        "no-unused-private-class-members": "off",
        "no-unnecessary-await": "off"
      }
    },
    {
      "files": ["test/**", "bench/**"],
      "rules": {
        "no-shadow-restricted-names": "off",
        "no-empty-file": "off",
        "no-unnecessary-await": "off"
      }
    },
    {
      "files": ["src/js/private.d.ts"],
      "rules": {
        // `util.types.isNumberObject(value)` says that `value` is a `Number`.
        "typescript/no-wrapper-object-types": "off"
      }
    },
    {
      "files": ["src/js/**"],
      "rules": {
        // Reading `obj.prop` in an `if` condition and again in the body hits
        // the property (and any getter/Proxy trap) twice. Destructure or
        // cache the value in a local instead.
        "bun/no-duplicate-conditional-property-access": "error",

        // The same rule, except that `"unlikely";` may be the first statement of an arm of an `if`, which tells
        // `bun build --compile --aot` that the arm rarely runs.
        "no-unused-expressions": "off",
        "bun/no-unused-expressions": "error"
      }
    },
    {
      "files": ["src/js/builtins/**"],
      "rules": {
        "bun/no-unused-expressions": "off"
      }
    }
  ]
}
