+    mod kernel_timer {
+        pub(super) type timer_t = libc::c_int;
+
+        /// # Safety
+        /// `event` must contain initialized SIGEV_SIGNAL data and `timer` must be writable.
+        pub(super) unsafe fn timer_create(
