@@ -1418,6 +1428,13 @@ DevToolsWindow* DevToolsWindow::Create(
     if (!devtools_ui_controller || !devtools_ui_controller->CanDockDevtools()) {
       can_dock = false;
     }
+
+#if BUILDFLAG(ENABLE_CEF)
+    if (can_dock && browser && browser->cef_delegate()) {
