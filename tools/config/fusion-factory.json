{
  "schemaVersion": 1,
  "owner": "aphrody-infra",
  "enabled": true,
  "target": "vps",
  "executionOnlyTargets": [],
  "workspaceRoot": "/home/ubuntu/src/bun",
  "cacheRoot": "/home/ubuntu/build/storage/bun/factory/cache",
  "artifactRoot": "/home/ubuntu/build/storage/bun/factory/artifacts",
  "lockPath": "/home/ubuntu/build/locks/heavy.lock",
  "hostEnvironment": {
    "name": "APHRODY_BUILD_HOST",
    "value": "vps"
  },
  "rust": {
    "maxJobs": 12,
    "serialized": true,
    "wrapper": "scripts/build/rust/cargo-serial.sh",
    "incremental": false,
    "cache": "sccache"
  },
  "bun": {
    "heavyJobs": 1,
    "frozenLockfile": true
  },
  "local": {
    "allowed": ["help", "plan", "inventory", "source-edit", "scoped-static-check"],
    "heavyExecution": "remote"
  },
  "transport": {
    "owner": "aphrody-infra ssh",
    "sync": "sync",
    "exec": "exec",
    "sourcePolicy": "clean-pinned-first-party-source",
    "secrets": "host-local-private-files-only"
  },
  "retention": {
    "preserve": [
      "active-releases",
      "rollback-releases",
      "primary-data",
      "source-patches",
      "cargo-cache",
      "sccache",
      "bun-cache"
    ],
    "cleanup": "existing-infra-allowlist-only"
  },
  "repositories": {
    "bun-os": "/home/ubuntu/src/bun"
  },
  "cleanup": {
    "transientRoot": "/home/ubuntu/build/storage/bun/factory/transient",
    "privilegeBinary": "/usr/bin/sudo-rs",
    "retiredOutputs": []
  },
  "resources": {
    "reserveMemoryGiB": 8,
    "reserveDiskGiB": 32,
    "memoryPerJobGiB": 1
  }
}
