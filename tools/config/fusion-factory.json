{
  "schemaVersion": 1,
  "owner": "aphrody-infra",
  "enabled": true,
  "target": "vps",
  "executionOnlyTargets": [],
  "workspaceRoot": "/home/ubuntu/src/bun",
  "cacheRoot": "/home/ubuntu/build/bun/factory/cache",
  "artifactRoot": "/home/ubuntu/build/bun/factory/artifacts",
  "lockPath": "/home/ubuntu/build/locks/heavy.lock",
  "hostEnvironment": {
    "name": "APHRODY_BUILD_HOST",
    "value": "vps"
  },
  "builds": {
    "mode": "multi",
    "slots": 3,
    "jobsPerSlot": 4,
    "sccacheGiB": 150,
    "ccacheGiB": 100
  },
  "lanes": {
    "runtime": { "cwd": "/home/ubuntu/src/bun" },
    "os": { "cwd": "/home/ubuntu/src/bun-os" },
    "web": { "cwd": "/home/ubuntu/src/bun-os" }
  },
  "rust": {
    "maxJobs": 12,
    "serialized": false,
    "wrapper": "scripts/build/rust/cargo-serial.sh",
    "incremental": false,
    "cache": "sccache"
  },
  "bun": {
    "heavyJobs": 3,
    "frozenLockfile": true
  },
  "local": {
    "allowed": ["help", "plan", "inventory", "source-edit", "scoped-static-check"],
    "heavyExecution": "remote"
  },
  "transport": {
    "owner": "aphrody-infra ssh",
    "sync": "sync",
    "exec": "exec",
    "sourcePolicy": "clean-pinned-first-party-source",
    "secrets": "host-local-private-files-only"
  },
  "retention": {
    "preserve": [
      "active-releases",
      "rollback-releases",
      "primary-data",
      "source-patches",
      "cargo-cache",
      "sccache",
      "bun-cache"
    ],
    "cleanup": "existing-infra-allowlist-only"
  },
  "repositories": {
    "bun-os": "/home/ubuntu/src/bun"
  },
  "cleanup": {
    "transientRoot": "/home/ubuntu/build/bun/factory/transient",
    "privilegeBinary": "/usr/bin/sudo-rs",
    "retiredOutputs": []
  },
  "resources": {
    "reserveMemoryGiB": 8,
    "reserveDiskGiB": 32,
    "memoryPerJobGiB": 1
  },
  "google": {
    "home": "/home/ubuntu",
    "depotTools": "/home/ubuntu/depot_tools",
    "srcRoot": "/home/ubuntu/src",
    "outRoot": "/home/ubuntu/build/out",
    "cacheRoot": "/home/ubuntu/build/google/cache",
    "jobs": 12,
    "targets": {
      "chromium": {
        "kind": "gclient",
        "checkout": "/home/ubuntu/src/chromium",
        "url": "https://chromium.googlesource.com/chromium/src.git",
        "source": "src",
        "revision": "e20c553087353010f4b71143841c189447ac1628",
        "configs": {
          "release": "is_debug=false is_component_build=true symbol_level=0 blink_symbol_level=0 v8_symbol_level=0 use_remoteexec=false"
        },
        "slots": 2,
        "maxSlots": 2,
        "ninjaTargets": ["chrome"]
      },
      "chromiumos": {
        "kind": "repo",
        "checkout": "/home/ubuntu/src/chromiumos",
        "url": "https://chromium.googlesource.com/chromiumos/manifest",
        "branch": "stable",
        "configs": {},
        "ninjaTargets": []
      },
      "cef": {
        "kind": "gclient",
        "checkout": "/home/ubuntu/src/cef",
        "url": "https://bitbucket.org/chromiumembedded/cef.git",
        "source": "cef",
        "configs": {},
        "ninjaTargets": []
      },
      "brave-core": {
        "kind": "external",
        "checkout": "/home/ubuntu/src/brave-core",
        "configs": {},
        "ninjaTargets": []
      }
    }
  }
}
