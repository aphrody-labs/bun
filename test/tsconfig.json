{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Tests never emit declarations, and they import files from all over the repository.
    "composite": false,
    "lib": ["ESNext"],
    "paths": {
      // M3 owns its DOM implementation; this project consumes its emitted public API.
      "@aphrody/m3-tokens/dynamic-color": ["../build/types/m3-tokens/dynamic-color.d.ts"],
      "harness": ["./harness.ts"],
      "registry": ["./packages/registry/test-registry.ts"],
      "mkfifo": ["./mkfifo.ts"],
      "node-harness": ["./js/node/harness.ts"],
      "s3-server": ["./packages/s3-server/index.ts"],
      "deno:harness": ["./js/deno/harness.ts"],
      "bun:internal-for-testing": ["../src/js/internal-for-testing.ts"],
      "foo/bar": ["./js/bun/resolve/baz.js"],
      "@faasjs/*": ["./js/bun/resolve/*.js", "./js/bun/resolve/*/src/index.js"],
      "@faasjs/larger/*": ["./js/bun/resolve/*/larger-index.js"],
      "bake/*": ["../src/runtime/bake/client/*"],
      "_util/*": ["./_util/*"],
      "js/*": ["./js/*"],
      "bun": ["../packages/bun-types/bun.d.ts"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    // Keep type references inside this checkout when it is nested in another one (see src/js/tsconfig.json).
    "typeRoots": ["./node_modules/@types", "../packages/bun-types/node_modules/@types"]
  },
  "include": [
    //
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.cts",
    "../packages/bun-types/index.d.ts",
    "../src/js/internal-for-testing.ts",
    "../scripts/glob-sources.ts",
    "../scripts/build/error.ts",
    "bake/exit-code-map.mjs",
    "docker/prestart-map.mjs"
  ],
  "exclude": [
    "fixtures",
    "__snapshots__", // bun snapshots (toMatchSnapshot)
    "./snapshots",
    "./js/deno",
    "./node.js", // entire node.js upstream repository
    "./js/node/test", // vendored from Node.js
    "bundler/transpiler/react-compiler-fixtures", // vendored from the React Compiler
    "bundler/transpiler/esbuild-decorator-tests.ts", // standard decorators, this project sets experimentalDecorators
    "regression/issue/14477/*-mismatch.tsx", // deliberately-mismatched JSX, the test asserts the parse error
    "integration/bun-types/fixture", // declares globals, bun-types.test.ts checks it with its own tsconfig.json
    "aot/programs", // many declare globals, run-programs.ts builds each with their own tsconfig.json
    "aot/ir", // texts that the compiler is asked about: some declare globals, and each folder has its own tsconfig.json
    "aot/checker-queries",
    "aot/backend-packages/programs",
    "aot/backend-packages/more-programs",
    "aot/frameworks/apps",
    // Apps with their own package.json and tsconfig.json. Their dependencies are installed by the test.
    "integration/expo-app/app",
    "integration/expo-app/components",
    "integration/expo-app/constants",
    "integration/expo-app/hooks",
    "integration/next-pages/src",
    "integration/next-pages/tailwind.config.ts",
    "integration/vite-build/the-test-app",
    "js/third_party/astro/fixtures",
    "js/third_party/next-auth/fixture",
    "js/third_party/pnpm/install_fixture",
    // checked inside the installed fixture (React 19, react-server-dom-parcel), see next-bun-app.test.ts
    "integration/next-bun-app/app",
    "integration/next-bun-app/suite",
    "integration/next-bun-app/proxy.ts",
    "integration/ecma_pipeline",
    // Executed by jsx-production.test.ts with their local react-jsx/react-jsxdev configurations.
    "bundler/transpiler/jsx-production.tsx",
    "bundler/transpiler/jsx-production-entry.ts",
    "bundler/transpiler/jsx-dev/jsx-dev.tsx"
  ]
}
