{
  "name": "@aphrody/bun-runtime-sdk",
  "version": "0.2.0",
  "description": "SDK of the buv native runtime: versioned buv C ABI with compatible yolo exports and Bun, .NET and Python bindings",
  "license": "MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun.git",
    "directory": "packages/bun-runtime-sdk"
  },
  "files": [
    "src",
    "include",
    "runtime.d.ts",
    "README.md",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./modules": "./src/modules.ts",
    "./preload": "./src/preload.ts",
    "./runtime.d.ts": "./runtime.d.ts",
    "./bundler": "./src/bundler.ts",
    "./artifact": "./src/artifact.ts",
    "./release": "./src/release.ts",
    "./ffi": "./src/ffi.ts",
    "./tooling": "./src/tooling.ts",
    "./tooling-schema": "./src/tooling-schema.ts",
    "./desktop": "./src/desktop.ts",
    "./browser": "./src/browser.ts",
    "./gpu": "./src/gpu.ts",
    "./python": "./src/python.ts",
    "./dotnet": "./src/dotnet.ts",
    "./desktop-artifact": "./src/desktop-artifact.ts",
    "./src/*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "cargo build --profile runtime -p yolo-runtime",
    "test": "bun test test",
    "test:rust": "cargo test",
    "test:dotnet": "dotnet test dotnet/YoloRuntime.slnx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stage": "bun scripts/stage.ts",
    "test:python": "YOLO_RUNTIME_HOME=target/artifact uv run --no-project --with pytest pytest python/ctypes"
  },
  "dependencies": {},
  "engines": {
    "bun": ">=1.4.3"
  }
}
