{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ESNext"
    ]
  },
  "include": [
    "src/**/*",
    "runtime.d.ts",
    "examples/**/*",
    "test/**/*"
  ]
}
