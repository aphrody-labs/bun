{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "typeRoots": ["../bun-types/node_modules/@types"],
    "paths": { "bun": ["../bun-types/bun.d.ts"] },
    "lib": ["ESNext"]
  },
  "include": ["src/**/*", "runtime.d.ts", "examples/**/*", "test/**/*", "../bun-types/index.d.ts"]
}
