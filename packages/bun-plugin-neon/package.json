{
  "name": "@aphrody/bun-plugin-neon",
  "version": "1.4.4",
  "description": "Neon PostgreSQL connections and migrations on Bun.SQL",
  "license": "MIT",
  "files": [
    "README.md",
    "src",
    "tsconfig.json"
  ],
  "type": "module",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./migrations": {
      "types": "./src/migrations.ts",
      "bun": "./src/migrations.ts",
      "import": "./src/migrations.ts",
      "default": "./src/migrations.ts"
    },
    "./http": {
      "types": "./src/http.ts",
      "import": "./src/http.ts",
      "default": "./src/http.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test ./test",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0"
  },
  "devDependencies": {
    "@aphrody/bun-types": "workspace:*"
  },
  "peerDependencies": {
    "@aphrody/bun-types": ">=1.4.4"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
