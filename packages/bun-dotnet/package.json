{
  "name": "@aphrody/bun-dotnet",
  "version": "1.4.7",
  "description": "Optional Microsoft node-api-dotnet payload and compatibility facade for Bun's canonical bun:dotnet SDK",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "dotnet/out/pkg/node-api-dotnet",
    "dotnet/out/pkg/node-api-dotnet-generator"
  ],
  "scripts": {
    "build": "dotnet pack dotnet -c Release",
    "test": "bun test ./test",
    "test:dotnet": "dotnet test dotnet/test/NodeApi.Test.csproj -f net10.0"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
