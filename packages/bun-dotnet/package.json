{
  "name": "@aphrody/bun-dotnet",
  "version": "0.1.0",
  "description": ".NET 10 hosted in Bun: node-api-dotnet (MIT) absorbed in dotnet/, built by dotnet pack with Bun as the JS runtime",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "dotnet/out/pkg/node-api-dotnet",
    "dotnet/out/pkg/node-api-dotnet-generator"
  ],
  "scripts": {
    "build": "dotnet pack dotnet -c Release",
    "test": "bun test ./test",
    "test:dotnet": "dotnet test dotnet/test/NodeApi.Test.csproj -f net10.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
