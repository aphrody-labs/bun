{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "Preserve",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "../bun-types/index.d.ts"]
}
