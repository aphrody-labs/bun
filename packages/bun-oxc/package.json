{
  "name": "bun-plugin-oxc",
  "version": "0.3.0",
  "description": "Oxc 0.153 for Bun: parser, transformer (TS, JSX, decorators, React Refresh), isolated declarations, minifier, resolver, oxlint (all rules, fixes) and oxfmt in one Node-API addon, as a Bun plugin, a typed API, oxc-parser/oxc-transform/oxc-minify drop-ins and a CLI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-labs/bun",
    "directory": "packages/bun-oxc"
  },
  "homepage": "https://github.com/aphrody-labs/bun/tree/main/packages/bun-oxc",
  "keywords": [
    "bun",
    "plugin",
    "oxc",
    "typescript",
    "jsx",
    "minify",
    "lint",
    "oxlint",
    "oxfmt",
    "resolver",
    "isolated-declarations"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./parser": {
      "types": "./src/parser.ts",
      "default": "./src/parser.ts"
    },
    "./transform": {
      "types": "./src/transform.ts",
      "default": "./src/transform.ts"
    },
    "./minify": {
      "types": "./src/minify.ts",
      "default": "./src/minify.ts"
    },
    "./oxlint": {
      "types": "./src/oxlint.ts",
      "default": "./src/oxlint.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bun-oxc": "./src/cli.ts"
  },
  "files": [
    "src",
    "vendor",
    "README.md",
    "*.node"
  ],
  "napi": {
    "name": "bun-plugin-oxc",
    "crate": "bun-plugin-oxc-napi"
  },
  "scripts": {
    "build": "bun ../../scripts/aphrody/build-napi.ts .",
    "test": "cargo test --workspace && bun test ../../test/integration/bun-plugin-oxc/",
    "sync-oxc-js": "bun scripts/sync-oxc-js.ts"
  },
  "dependencies": {
    "@oxc-project/types": "0.153.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
