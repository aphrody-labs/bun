{
  "name": "bun-video-showcase",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "r2_buckets": [{ "binding": "SHOWCASE", "bucket_name": "aphrody-video" }],
  "vars": { "SHOWCASE_PREFIX": "showcase/20261022-v3" },
  // No route: video.aphrody.com redirects to the gallery of the Bun site (bun.aphrody.com/video), which serves
  // the same aphrody-video renders through the aphrody-app Worker.
  "routes": [],
}
