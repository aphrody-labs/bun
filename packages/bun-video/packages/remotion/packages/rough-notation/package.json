{
	"name": "@remotion/rough-notation",
	"version": "4.0.534",
	"description": "Rough annotation primitives for Remotion",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"module": "dist/esm/index.mjs",
	"repository": {
		"url": "https://github.com/remotion-dev/remotion/tree/main/packages/rough-notation"
	},
	"type": "module",
	"scripts": {
		"test": "bun test src/test",
		"formatting": "bun fmt src --check",
		"format": "bun fmt src",
		"lint": "bun lint src",
		"watch": "bun ../../../../../../scripts/aphrody/emit-typescript.ts -w",
		"make": "bun ../../../../../../scripts/aphrody/emit-typescript.ts && bun --env-file=../.env.bundle bundle.ts"
	},
	"author": "Jonny Burger <jonny@remotion.dev>",
	"contributors": [
		"Mohit Yadav <yo@mohitya.dev>"
	],
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/remotion-dev/remotion/issues"
	},
	"dependencies": {
		"@remotion/paths": "workspace:*",
		"remotion": "workspace:*",
		"roughjs": "4.6.6"
	},
	"peerDependencies": {
		"react": ">=16.8.0",
		"react-dom": ">=16.8.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"module": "./dist/esm/index.mjs",
			"import": "./dist/esm/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"devDependencies": {
		"react": "catalog:",
		"react-dom": "catalog:",
		"@remotion/eslint-config-internal": "workspace:*",
		"eslint": "catalog:"

	},
	"keywords": [
		"remotion",
		"rough-notation",
		"annotations"
	],
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://www.remotion.dev/docs/rough-notation"
}
