{
  "name": "@hyperframes/engine",
  "version": "0.8.144",
  "description": "Seekable web page to video rendering engine (Puppeteer + FFmpeg)",
  "repository": {
    "type": "git",
    "url": "https://github.com/heygen-com/hyperframes",
    "directory": "packages/engine"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./alpha-blit": {
      "bun": "./src/utils/alphaBlit.ts",
      "import": "./src/utils/alphaBlit.ts",
      "types": "./src/utils/alphaBlit.ts"
    },
    "./chrome-host-ceiling": {
      "bun": "./src/services/chromeHostCeiling.ts",
      "import": "./src/services/chromeHostCeiling.ts",
      "types": "./src/services/chromeHostCeiling.ts"
    },
    "./system-memory": {
      "bun": "./src/services/systemMemory.ts",
      "import": "./src/services/systemMemory.ts",
      "types": "./src/services/systemMemory.ts"
    },
    "./shader-transitions": {
      "bun": "./src/utils/shaderTransitions.ts",
      "import": "./src/utils/shaderTransitions.ts",
      "types": "./src/utils/shaderTransitions.ts"
    },
    "./package.json": "./package.json",
    "./native-webview-capture": {
      "bun": "./src/services/nativeWebViewCapture.ts",
      "types": "./src/services/nativeWebViewCapture.ts",
      "import": "./src/services/nativeWebViewCapture.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./alpha-blit": {
        "import": "./dist/utils/alphaBlit.js",
        "types": "./dist/utils/alphaBlit.d.ts"
      },
      "./chrome-host-ceiling": {
        "import": "./dist/services/chromeHostCeiling.js",
        "types": "./dist/services/chromeHostCeiling.d.ts"
      },
      "./system-memory": {
        "import": "./dist/services/systemMemory.js",
        "types": "./dist/services/systemMemory.d.ts"
      },
      "./shader-transitions": {
        "import": "./dist/utils/shaderTransitions.js",
        "types": "./dist/utils/shaderTransitions.d.ts"
      },
      "./package.json": "./package.json",
      "./native-webview-capture": {
        "import": "./dist/services/nativeWebViewCapture.js",
        "types": "./dist/services/nativeWebViewCapture.d.ts"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "bun ../../../../../../scripts/aphrody/emit-typescript.ts",
    "test": "vitest run && bun run test:native-webview",
    "typecheck": "bun check --noEmit",
    "test:native-webview": "bun test src/services/nativeWebViewCapture.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hyperframes/core": "workspace:^",
    "@hyperframes/parsers": "workspace:^",
    "hono": "^4.6.0",
    "linkedom": "^0.18.12",
    "puppeteer": "^25.8.0",
    "puppeteer-core": "^25.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@webgpu/types": "^0.1.69",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.3"
  }
}
