{
  "name": "@aphrody/bun-video",
  "version": "1.4.4",
  "description": "Bun video protocols, native capture adapters, and official Remotion and HyperFrames integrations",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "bun-video-chrome": "./labs/crunchyroll-app.ts",
    "bun-video-dash": "./labs/dash-lab.ts",
    "bun-video-har": "./labs/hls-lab-har.ts",
    "bun-video-hls": "./labs/hls-lab.ts",
    "bun-video-keychain": "./labs/hls-keychain.ts",
    "bun-video-shortcuts": "./labs/crunchyroll-shortcuts.ts",
    "bun-video-webgpu": "./labs/webgpu.ts",
    "bun-video-engine": "./umbrella-src/cli.ts"
  },
  "scripts": {
    "check:types": "bun check --project tsconfig.json",
    "lint": "bunx oxlint src labs test",
    "format:check": "bunx oxfmt --check src labs test",
    "check": "bun run check:types && bun run lint && bun run format:check",
    "build:library": "bun scripts/build.ts --library",
    "pack": "bun pm pack",
    "release": "bun run check && bun run build:library && bun run pack",
    "publish:next": "bun run release && bun publish --access public --tag next"
  },
  "files": [
    "src",
    "umbrella-src",
    "remotion",
    "hyperframes",
    "native",
    "infra",
    "plugin",
    "scripts",
    "video-benchmark",
    "docs",
    "labs",
    "assets",
    "vendor/mediabunny",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mcp": "./src/mcp.ts",
    "./capabilities": "./src/capabilities.ts",
    "./hls": "./src/hls.ts",
    "./dash": "./src/dash.ts",
    "./mpd": "./src/dash.ts",
    "./har": "./src/har.ts",
    "./bitmovin": "./src/bitmovin.ts",
    "./crunchyroll": "./src/crunchyroll.ts",
    "./oauth": "./src/oauth.ts",
    "./secrets": "./src/secrets.ts",
    "./webgpu": "./src/webgpu.ts",
    "./mediabunny": "./vendor/mediabunny/src/index.ts",
    "./engine": "./umbrella-src/index.ts",
    "./encode": "./umbrella-src/encode.ts",
    "./computer": "./umbrella-src/computer.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "@aphrody/bun-runtime-sdk": "1.4.4",
    "@hyperframes/core": "0.8.144",
    "@hyperframes/engine": "0.8.144",
    "@hyperframes/parsers": "0.8.144",
    "@remotion/renderer": "4.0.534",
    "bitmovin-player": "8.279.0",
    "dashjs": "5.2.1",
    "fast-xml-parser": "5.11.2",
    "hls.js": "1.7.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "directory": "packages/bun-video",
    "url": "git+https://github.com/aphrody-labs/bun.git"
  },
  "bugs": {
    "url": "https://github.com/aphrody-labs/bun/issues"
  }
}
