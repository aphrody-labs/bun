{
  "name": "@aphrody/bun-plugin-tailwind",
  "version": "0.1.0",
  "description": "Tailwind CSS v4 for Bun: Bun.build, the HTML dev server and Bun.serve, a PostCSS plugin on the same engine, and a Material 3 preset",
  "keywords": [
    "bun",
    "bun-plugin",
    "tailwindcss",
    "postcss",
    "material-3"
  ],
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./postcss": {
      "types": "./src/postcss.ts",
      "require": {
        "bun": "./src/postcss.cjs",
        "default": "./dist/postcss.cjs"
      },
      "bun": "./src/postcss.ts",
      "default": "./dist/postcss.mjs"
    },
    "./m3": {
      "types": "./src/m3.ts",
      "bun": "./src/m3.ts",
      "default": "./dist/m3.mjs"
    },
    "./core": {
      "types": "./src/core.ts",
      "bun": "./src/core.ts",
      "default": "./dist/core.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@aphrody/m3-tailwind": "^3.3.7",
    "@aphrody/m3-tokens": "^3.3.7",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "enhanced-resolve": "^5.26.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/bun": "../bun-types",
    "postcss": "^8.5.6"
  },
  "peerDependencies": {
    "postcss": "^8"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "files": [
    "README.md",
    "src",
    "dist",
    "tsconfig.json"
  ]
}
