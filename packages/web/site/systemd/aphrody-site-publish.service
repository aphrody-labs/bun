# Republie aphrody.app quand origin/main ou les reçus natifs mesurés changent.
# Installation (VPS, utilisateur ubuntu) : voir packages/web/site/systemd/aphrody-site-publish.timer.
[Unit]
Description=Publication du site Bun, graphe et Neon depuis origin/main
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/aphrody-site-publish
Nice=19
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
MemoryHigh=2G
MemoryMax=4G
# Cold graph generation and publication exceed 30 minutes on the VPS storage pool.
TimeoutStartSec=2h
