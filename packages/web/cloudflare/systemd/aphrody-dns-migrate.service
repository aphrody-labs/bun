# OVH -> Cloudflare DNS migration, deferred steps (scripts/ovh.ts --switch --dnssec): name servers of domains
# whose OVH DNSSEC DS had to expire first, then Cloudflare DNSSEC once zones are active for 48 h. The timer disables
# itself when the script reports "migration complete".
# install -m 0644 packages/web/cloudflare/systemd/aphrody-dns-migrate.* ~/.config/systemd/user/
# systemctl --user daemon-reload && systemctl --user enable --now aphrody-dns-migrate.timer
[Unit]
Description=Migration DNS OVH vers Cloudflare (étapes différées)
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=900
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=APHRODY_SRC=%h/src/bun APHRODY_INFRA_ROOT=%h/src/aphrody
ExecStart=/usr/bin/env bash -c 'set -euo pipefail; git -C "$APHRODY_SRC" fetch -q origin main; w=$(mktemp -d); trap "rm -rf $w" EXIT; git -C "$APHRODY_SRC" archive origin/main packages/bun-cloudflare packages/web/cloudflare | tar -x -C "$w"; out=$(cd "$w/packages/bun-cloudflare" && bun install --frozen-lockfile --silent && bun ../web/cloudflare/scripts/ovh.ts --switch --dnssec 2>&1); echo "$out"; if grep -q "migration complete" <<<"$out"; then systemctl --user disable --now aphrody-dns-migrate.timer; fi'
