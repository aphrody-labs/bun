{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "typeRoots": [
      "../node_modules/@types",
      "../node_modules",
      "../../bun-cloudflare/node_modules",
      "../../../node_modules/@types"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types/experimental", "node"]
  },
  "include": ["src", "maintenance/worker.ts", "worker-configuration.d.ts"]
}
