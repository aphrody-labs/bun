// aphrody.app: the Aphrody Bun site and its AI/API routes, built from packages/web/site.
// Secrets and account credentials live in .env (git-ignored, see .env.example). KV, D1 and Queue
// resources without ids are provisioned by the first `wrangler deploy` and found by name afterwards.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "aphrody-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "app-audio.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-cad.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-compositing.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-documents.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-generation.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-images.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-interface-layouts.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-layout.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-pdf.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-photo-processing.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-slides.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-tables.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-vectors.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "app-video.aphrody.app/*", "zone_id": "f4dab237b9811435da6fee0b5b3438d4" },
    { "pattern": "aphrody.app", "custom_domain": true },
    { "pattern": "artcraft.aphrody.app", "custom_domain": true },
    { "pattern": "apt.aphrody.app", "custom_domain": true },
    { "pattern": "cadcraft.aphrody.app", "custom_domain": true },
    { "pattern": "deckcraft.aphrody.app", "custom_domain": true },
    { "pattern": "designcraft.aphrody.app", "custom_domain": true },
    { "pattern": "desktop.aphrody.app", "custom_domain": true },
    { "pattern": "effectcraft.aphrody.app", "custom_domain": true },
    { "pattern": "figcraft.aphrody.app", "custom_domain": true },
    { "pattern": "filmcraft.aphrody.app", "custom_domain": true },
    { "pattern": "gridcraft.aphrody.app", "custom_domain": true },
    { "pattern": "lightcraft.aphrody.app", "custom_domain": true },
    { "pattern": "pdfcraft.aphrody.app", "custom_domain": true },
    { "pattern": "photocraft.aphrody.app", "custom_domain": true },
    { "pattern": "soundcraft.aphrody.app", "custom_domain": true },
    { "pattern": "vectorcraft.aphrody.app", "custom_domain": true },
    { "pattern": "wordcraft.aphrody.app", "custom_domain": true },
    { "pattern": "www.aphrody.app", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/v1/*", "/mcp", "/a2a", "/message:send"],
  },
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "upload_source_maps": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://aphrody.app",
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_GATEWAY": "aphrody",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "YOLO_ENABLED": "false",
    "YOLO_QUOTA_QUALIFIED": "false",
    "YOLO_ORIGIN_URL": "",
    "YOLO_NATIVE_SOURCE": "",
    "YOLO_MODEL": "clef-flash",
  },
  "secrets": {
    "required": ["APP_SECRET", "NEON_DATABASE_URL", "TYPESAFE_API_KEY", "YOLO_API_TOKEN", "YOLO_ORIGIN_TOKEN"],
  },
  "r2_buckets": [{ "binding": "APHRODY", "bucket_name": "aphrody-assets" }],
  "d1_databases": [{ "binding": "DB", "database_name": "aphrody-app", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "CACHE" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "aphrody-app-jobs" }],
    "consumers": [{ "queue": "aphrody-app-jobs", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }],
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "workflows": [{ "name": "aphrody-app-ingest", "binding": "INGEST", "class_name": "Ingest" }],
  "ai": { "binding": "AI" },
  // bun-native dataset vectors (scripts/aphrody/dataset/publish.ts), created by provision.ts --only vectorize.
  "vectorize": [{ "binding": "BUN_NATIVE", "index_name": "bun-native" }],
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RAG_LIMITER", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } },
    { "name": "YOLO_LIMITER", "namespace_id": "1003", "simple": { "limit": 6, "period": 60 } },
  ],
  "version_metadata": { "binding": "VERSION" },
  "triggers": { "crons": ["17 3 * * *"] },
}
