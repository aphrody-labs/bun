# Copy to .env (git-ignored). Wrangler reads the CLOUDFLARE_* keys for its own authentication;
# only the keys in wrangler.jsonc "secrets.required" reach the Worker's env.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Worker secrets (uploaded by `bun run deploy` through --secrets-file).
APP_SECRET=

# R2 S3-compatible credentials, for rclone/aws-cli/Bun.S3Client outside the Worker.
R2_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
