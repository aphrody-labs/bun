{
  "name": "@aphrody/x",
  "version": "1.4.4",
  "description": "Headless X (Twitter) client for Bun: a thin import over the Rust crate aphrody-x (aphrody-ffi), with batch jobs for mass scripting. Cookie-auth GraphQL + REST, no API key. Includes local For You algo (x-algorithm port), store, and X function tools (XTools, x_* JSON Schema definitions) for Grok or any tool-calling model.",
  "keywords": [
    "aphrody",
    "aphrody-web",
    "bun",
    "client",
    "graphql",
    "headless",
    "twitter",
    "x"
  ],
  "bugs": {
    "url": "https://github.com/aphrody-labs/aphrody/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-labs/aphrody.git",
    "directory": "packages/x"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "LICENSE",
    "data"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "bun check --noEmit",
    "lint": "oxlint",
    "test": "bun test",
    "catalog:sync": "bun ../../../scripts/tools/web/x-catalog-sync.ts",
    "coverage": "bun ../../../scripts/tools/web/x-coverage.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@aphrody/bun": "3.3.8",
    "@aphrody/paths": "0.1.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "devDependencies": {
    "@types/bun": "npm:@aphrody/bun-types@1.4.4"
  }
}
