{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": false,
    "skipLibCheck": true,
    "strict": true,
    "types": [],
    "typeRoots": ["../bun-types/node_modules/@types"]
  },
  "include": ["src", "../bun-types/index.d.ts"],
  "exclude": ["node_modules"]
}
