{
  "name": "@aphrody/next-bun",
  "version": "0.2.0",
  "description": "Next.js on Bun: run next with no Node.js (Turbopack workers included), build the Pages Router with Bun.build (experimental), Next 16 / Tailwind 4 codemods and instant navigation testing",
  "license": "MIT AND Apache-2.0",
  "main": "index.js",
  "bin": {
    "next-bun": "bin/next-bun.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./run": {
      "types": "./lib/run.d.ts",
      "default": "./lib/run.js"
    },
    "./patch": "./lib/patch.js",
    "./config": "./lib/config.js",
    "./standalone": {
      "types": "./lib/standalone.d.ts",
      "default": "./lib/standalone.js"
    },
    "./codemods": "./codemods/index.ts",
    "./codemods/cli": "./codemods/cli.ts",
    "./codemods/lex": "./codemods/lex.ts",
    "./testing": "./testing/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin",
    "lib",
    "codemods",
    "testing",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "peerDependencies": {
    "next": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "types": "index.d.ts"
}
