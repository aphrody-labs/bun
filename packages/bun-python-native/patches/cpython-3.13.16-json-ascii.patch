 class TestEncode(CTest):
+    def test_ascii_string_writer(self):
+        class StringSubclass(str):
+            def __str__(self):
+                raise AssertionError('string conversion must not be called')
+
+        strings = ['', 'plain ASCII', 'item-' * 2048, 'item-' * 2048 + '\n',
+                   StringSubclass('subclass'), '\u00e9', '\u03a9', '\U0001f600']
+        strings.extend('prefix' + chr(code) + 'suffix' for code in range(128))
+        for ensure_ascii in (False, True):
+            for indent in (None, 0, 2):
+                for text in strings:
+                    with self.subTest(ensure_ascii=ensure_ascii,
+                                      indent=indent, text=text):
+                        value = [text, {text: 'ascii', 'key': text},
+                                 {0: text, True: 'true', None: 'none',
+                                  1.5: 'float'}]
+                        options = dict(ensure_ascii=ensure_ascii, indent=indent,
+                                       separators=(',', ':'))
+                        self.assertEqual(self.dumps(value, **options),
+                                         pyjson.dumps(value, **options))
+
+    def test_ascii_string_writer_after_wide_output(self):
+        for prefix in ('\u00e9', '\u03a9', '\U0001f600'):
+            value = [prefix, {'plain': '', 'key': 'item-' * 2048}, 'ascii']
+            for indent in (None, 2):
+                with self.subTest(prefix=prefix, indent=indent):
+                    options = dict(ensure_ascii=False, indent=indent)
+                    self.assertEqual(self.dumps(value, **options),
+                                     pyjson.dumps(value, **options))
+
+    def test_ascii_string_writer_custom_encoder(self):
+        calls = []
+
+        def encode_string(value):
+            calls.append(value)
+            return pyjson.dumps('custom:' + value)
+
+        encoder = self.json.encoder.c_make_encoder(
+            None, None, encode_string, None, ':', ',', False, False, True)
+        result = ''.join(encoder({'key': 'value'}, 0))
+        self.assertEqual(result, '{"custom:key":"custom:value"}')
+        self.assertEqual(calls, ['key', 'value'])
+
     def test_make_encoder(self):
         # bpo-6986: The interpreter shouldn't crash in case c_make_encoder()
         # receives invalid arguments.
