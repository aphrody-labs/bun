+static int
+encoder_write_string(PyEncoderObject *s, _PyUnicodeWriter *writer,
+                     PyObject *obj)
+{
+    PyObject *encoded;
+
+    if (s->fast_encode && PyUnicode_IS_ASCII(obj)) {
+        Py_ssize_t length = PyUnicode_GET_LENGTH(obj);
+        const Py_UCS1 *input = PyUnicode_1BYTE_DATA(obj);
+        Py_ssize_t i;
+
+        for (i = 0; i < length; i++) {
+            if (!S_CHAR(input[i])) {
+                break;
+            }
+        }
+        if (i == length) {
+            if (length > PY_SSIZE_T_MAX - 2) {
+                PyErr_SetString(PyExc_OverflowError,
+                                "string is too long to escape");
+                return -1;
+            }
+            if (_PyUnicodeWriter_Prepare(writer, length + 2, 127) < 0) {
+                return -1;
+            }
+            /* Avoid allocating and copying a quoted temporary string. */
+            if (writer->kind == PyUnicode_1BYTE_KIND) {
+                Py_UCS1 *output = (Py_UCS1 *)writer->data + writer->pos;
+
+                output[0] = '"';
+                memcpy(output + 1, input, length);
+                output[length + 1] = '"';
+                writer->pos += length + 2;
+                return 0;
+            }
+            if (_PyUnicodeWriter_WriteChar(writer, '"') < 0 ||
+                _PyUnicodeWriter_WriteASCIIString(writer,
+                                                 (const char *)input,
+                                                 length) < 0 ||
+                _PyUnicodeWriter_WriteChar(writer, '"') < 0) {
+                return -1;
+            }
+            return 0;
+        }
+        if (s->fast_encode == (PyCFunction)py_encode_basestring_ascii) {
+            encoded = ascii_escape_unicode_prefix(obj, i);
+        }
+        else {
+            encoded = escape_unicode_prefix(obj, i);
+        }
+    }
+    else {
+        encoded = encoder_encode_string(s, obj);
+    }
+    if (encoded == NULL) {
+        return -1;
+    }
+    return _steal_accumulate(writer, encoded);
+}
